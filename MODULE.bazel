module(
    name = "wasmedge_go",
)

bazel_dep(name = "rules_go", version = "0.62.0")
bazel_dep(name = "rules_cc", version = "0.2.22")

# Bazel is reproducible on the current Go toolchain. The go.mod directive
# remains the module's minimum supported language version, and CI is configured
# for the full supported Go matrix.
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.26.5")

wasmedge_sdk_repository = use_repo_rule(
    "//:wasmedge_sdk.bzl",
    "wasmedge_sdk_repository",
)

# The binding intentionally does not choose or download a native runtime.
# Point this repository at a WasmEdge 0.17.1 SDK with:
#
#   bazel test --repo_env=WASMEDGE_SDK=/absolute/sdk/prefix //...
wasmedge_sdk_repository(name = "wasmedge_sdk")
